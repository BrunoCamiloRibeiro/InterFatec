@* Declara o modelo de dados utilizado por esta View para realizar o cadastro *@
@model LoginViewModel

@{
    @* Define o título da página exibido na aba do navegador *@
    ViewData["Title"] = "Cadastro";
}

<!-- Contêiner principal do Bootstrap, adicionando margem no topo -->
<div class="container mt-5">
    <!-- Linha com centralização do conteúdo -->
    <div class="row justify-content-center">
        <!-- Coluna ajustada para tamanho médio (6 de 12 colunas) -->
        <div class="col-md-6">
            <!-- Cartão com sombra suave ao redor do formulário -->
            <div class="card shadow">
                <div class="card-header bg-danger-subtle text-danger-emphasis border-bottom border-danger-subtle">
                    <h4 class="mb-0 fw-semibold">Crie sua Conta</h4>
                </div>
                <div class="card-body">
                    @* 
                        Início do formulário. 
                        A propriedade action aponta diretamente para o método "RegistrarUsuario" no Controller "Login".
                        O método POST envia as informações de forma segura.
                    *@
                    <form method="post" action="@Url.Action("RegistrarUsuario", "Login")">
                        @* Html Helper para exibir os erros de validação globais do modelo *@
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="mb-3">
                            <label class="form-label">Tipo de cadastro</label>
                            <div class="d-flex gap-3">
                                <!-- Botões de rádio para escolha do tipo de usuário -->
                                <div class="form-check">
                                    @* Lógica condicional (operador ternário) para manter selecionado o rádio que já veio no Model *@
                                    <input class="form-check-input" type="radio" name="CadastroTipo" id="cadastroTipoCliente" value="Cliente" @(Model.CadastroTipo == FabysUnha.Enums.TipoUsuario.Cliente ? "checked" : "")>
                                    <label class="form-check-label" for="cadastroTipoCliente">Cliente</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="CadastroTipo" id="cadastroTipoFuncionario" value="Funcionario" @(Model.CadastroTipo == FabysUnha.Enums.TipoUsuario.Funcionario ? "checked" : "")>
                                    <label class="form-check-label" for="cadastroTipoFuncionario">Funcionário</label>
                                </div>
                            </div>
                        </div>

                        <!-- Campos do formulário com validação HTML (required, minlength, type="tel", etc) -->
                        <div class="mb-3">
                            <label for="cadastroNome" class="form-label">Nome</label>
                            <input type="text"
                                   class="form-control"
                                   id="cadastroNome"
                                   name="CadastroNome"
                                   placeholder="Seu nome completo"
                                   value="@Model.CadastroNome"
                                   required>
                        </div>

                        <div class="mb-3">
                            <label for="cadastroTelefone" class="form-label">Telefone</label>
                            <input type="tel"
                                   class="form-control"
                                   id="cadastroTelefone"
                                   name="CadastroTelefone"
                                   placeholder="(11) 98765-4321"
                                   value="@Model.CadastroTelefone"
                                   required>
                        </div>

                        <div class="mb-3">
                            <label for="cadastroSenha" class="form-label">Senha</label>
                            <input type="password"
                                   class="form-control"
                                   id="cadastroSenha"
                                   name="CadastroSenha"
                                   placeholder="••••••••"
                                   value="@Model.CadastroSenha"
                                   minlength="6"
                                   required>
                        </div>

                        <div class="mb-3">
                            <label for="cadastroConfirmacaoSenha" class="form-label">Confirmar Senha</label>
                            <input type="password"
                                   class="form-control"
                                   id="cadastroConfirmacaoSenha"
                                   name="CadastroConfirmacaoSenha"
                                   placeholder="••••••••"
                                   value="@Model.CadastroConfirmacaoSenha"
                                   minlength="6"
                                   required>
                        </div>

                        <!-- Botão de submissão do formulário -->
                        <button type="submit" class="btn btn-danger w-100">
                            Criar Conta
                        </button>
                    </form>

                    <hr>
                    <!-- Link para redirecionamento caso o usuário já possua conta -->
                    <p class="text-center text-muted mb-0">
                        @* Url.Action gera a URL baseada no Action e Controller *@
                        <small>Já possui uma conta? <a href="@Url.Action("Index", "Login")" class="text-danger text-decoration-none">Faça Login</a></small>
                    </p>
                </div>

                <div class="card-footer bg-light text-center">
                    <small class="text-muted">
                        Sistema de Agendamentos • Fabys Unha
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@* Bloco section que injeta o script Javascript na seção definida do Layout principal *@
@section Scripts {
    <script>
        // Adiciona um listener para aguardar o carregamento completo do DOM
        document.addEventListener('DOMContentLoaded', function() {
            // Lógica para adicionar uma máscara de formatação em tempo real no input de telefone
            const telInputs = document.querySelectorAll('input[type="tel"]');
            telInputs.forEach(input => {
                input.addEventListener('input', function(e) {
                    // Remove tudo que não for número (D é qualquer caractere não numérico)
                    let val = e.target.value.replace(/\D/g, '');
                    // Limita a string a 11 caracteres numéricos
                    if (val.length > 11) val = val.slice(0, 11);
                    
                    // Aplica as expressões regulares de acordo com o tamanho da string
                    if (val.length > 10) {
                        val = val.replace(/^(\d{2})(\d{5})(\d{4}).*/, '($1) $2-$3');
                    } else if (val.length > 6) {
                        val = val.replace(/^(\d{2})(\d{4})(\d{0,4}).*/, '($1) $2-$3');
                    } else if (val.length > 2) {
                        val = val.replace(/^(\d{2})(\d{0,5})/, '($1) $2');
                    } else if (val.length > 0) {
                        val = val.replace(/^(\d*)/, '($1');
                    }
                    e.target.value = val;
                });
            });
        });
    </script>
}
