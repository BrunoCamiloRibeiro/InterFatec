@* Define o tipo de modelo (ViewModel) esperado nesta View para auxiliar a autenticação *@
@model LoginViewModel

@{
    @* Configura o título que aparece no Header/Aba da página *@
    ViewData["Title"] = "Login";
}

<!-- Estrutura principal do contêiner com margem superior (mt-5) -->
<div class="container mt-5">
    <div class="row justify-content-center">
        <!-- Coluna centralizada contendo a caixa de login -->
        <div class="col-md-6">
            <div class="card shadow">
                <!-- Cabeçalho do Card com cores e bordas padronizadas usando classes Bootstrap -->
                <div class="card-header bg-danger-subtle text-danger-emphasis border-bottom border-danger-subtle">
                    <h4 class="mb-0 fw-semibold">Faça seu Login</h4>
                </div>
                <div class="card-body">
                    @* Lógica condicional em C# para exibir um alerta de sucesso caso venha do registro (usando TempData) *@
                    @if (TempData["RegistroSucesso"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @TempData["RegistroSucesso"]
                        </div>
                    }
                    <!-- Nav Tabs (Sistema de Abas do Bootstrap) para dividir os tipos de login -->
                    <ul class="nav nav-tabs mb-4" id="loginTabs" role="tablist">
                        <!-- Aba Cliente -->
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="cliente-tab" data-bs-toggle="tab" 
                                    data-bs-target="#cliente" type="button" role="tab" 
                                    aria-controls="cliente" aria-selected="true">
                                👤 Cliente
                            </button>
                        </li>

                        <!-- Aba Funcionário -->
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="funcionario-tab" data-bs-toggle="tab" 
                                    data-bs-target="#funcionario" type="button" role="tab" 
                                    aria-controls="funcionario" aria-selected="false">
                                💼 Funcionário
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content: Conteúdo correspondente a cada aba -->
                    <div class="tab-content" id="loginTabContent">
                        
                        <!-- ABA 1: CLIENTE (Esta aba possui classe "show active", ou seja, inicia visível) -->
                        <div class="tab-pane fade show active" id="cliente" role="tabpanel" aria-labelledby="cliente-tab">
                            @* Formulário específico para submissão dos dados de Cliente *@
                            <form method="post" action="@Url.Action("ClienteLogin", "Login")">

                                @* Sumário de validações para erros do Model que sejam globais *@
                                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                <!-- Campo Telefone com atributos HTML de tipagem (tel) e obrigatoriedade (required) -->
                                <div class="mb-3">
                                    <label for="telefone" class="form-label">Telefone</label>
                                    <input type="tel" 
                                           class="form-control" 
                                           id="telefone" 
                                           name="telefone" 
                                           placeholder="(11) 98765-4321"
                                           required>
                                    <small class="form-text text-muted">
                                        Digite o telefone cadastrado no seu agendamento
                                    </small>
                                </div>

                                <!-- Campo Senha (password) e obrigatoriedade de ter pelo menos 6 caracteres (minlength) -->
                                <div class="mb-3">
                                    <label for="senhaCliente" class="form-label">Senha</label>
                                    <input type="password" 
                                           class="form-control" 
                                           id="senhaCliente" 
                                           name="senha" 
                                           placeholder="••••••••"
                                           minlength="6"
                                           required>
                                    <small class="form-text text-muted">
                                        Use a senha cadastrada no seu perfil
                                    </small>
                                </div>

                                <!-- Botão Submit exclusivo para a rota de Cliente -->
                                <button type="submit" class="btn btn-danger w-100">
                                    Acessar meus Agendamentos
                                </button>
                            </form>

                            <hr>
                            <!-- Link que utiliza Url.Action para enviar o usuário à tela de Cadastro -->
                            <p class="text-center text-muted mb-0">
                                <small>Primeira vez? <a href="@Url.Action("Cadastro", "Login")" class="text-danger text-decoration-none">Cadastre-se aqui</a> para usar o sistema.</small>
                            </p>
                        </div>



                        <!-- ABA 2: FUNCIONÁRIO (Inicia oculta - classe "fade") -->
                        <div class="tab-pane fade" id="funcionario" role="tabpanel" aria-labelledby="funcionario-tab">
                            @* Formulário de submissão do login direcionado para a Action "FuncionarioLogin" *@
                            <form method="post" action="@Url.Action("FuncionarioLogin", "Login")">

                                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                <div class="mb-3">
                                    <label for="telefoneFuncionario" class="form-label">Telefone</label>
                                    <input type="tel" 
                                           class="form-control" 
                                           id="telefoneFuncionario" 
                                           name="telefone" 
                                           placeholder="(11) 98765-4321"
                                           required>
                                </div>

                                <div class="mb-3">
                                    <label for="senha" class="form-label">Senha</label>
                                    <input type="password" 
                                           class="form-control" 
                                           id="senha" 
                                           name="senha" 
                                           placeholder="••••••••"
                                           minlength="6"
                                           required>
                                </div>

                                <!-- Botão Submit para acessar a área administrativa -->
                                <button type="submit" class="btn btn-danger w-100">
                                    Entrar na Área Administrativa
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Rodapé informativo do sistema de Login -->
                <div class="card-footer bg-light text-center">
                    <small class="text-muted">
                        Sistema de Agendamentos • Fabys Unha
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@* Script carregado na seção nomeada "Scripts" definida no arquivo _Layout.cshtml *@
@section Scripts {
    <script>
        // Função ativada quando o DOM da página inteira é carregado
        document.addEventListener('DOMContentLoaded', function() {
            // Lógica Razor para capturar a aba ativa previamente salva via ViewBag
            const activeTab = '@(ViewBag.ActiveTab ?? string.Empty)';
            if (activeTab === 'funcionario') {
                new bootstrap.Tab(document.getElementById('funcionario-tab')).show();
                return;
            }

            // Lê a URL buscando o parâmetro "tipo" (QueryString) para ativar a aba correta se necessário
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('tipo') === 'funcionario') {
                new bootstrap.Tab(document.getElementById('funcionario-tab')).show();
            }

            // Máscara de telefone utilizando JavaScript Vanilla
            const telInputs = document.querySelectorAll('input[type="tel"]');
            telInputs.forEach(input => {
                input.addEventListener('input', function(e) {
                    let val = e.target.value.replace(/\D/g, ''); // Remove tudo que não for dígito
                    if (val.length > 11) val = val.slice(0, 11);
                    
                    // Lógica para formatar visualmente como: (XX) XXXXX-XXXX ou (XX) XXXX-XXXX
                    if (val.length > 10) {
                        val = val.replace(/^(\d{2})(\d{5})(\d{4}).*/, '($1) $2-$3');
                    } else if (val.length > 6) {
                        val = val.replace(/^(\d{2})(\d{4})(\d{0,4}).*/, '($1) $2-$3');
                    } else if (val.length > 2) {
                        val = val.replace(/^(\d{2})(\d{0,5})/, '($1) $2');
                    } else if (val.length > 0) {
                        val = val.replace(/^(\d*)/, '($1');
                    }
                    e.target.value = val;
                });
            });
        });
    </script>
}
