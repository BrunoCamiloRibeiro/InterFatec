@* Declara a tipagem do modelo. Neste caso, uma coleção (IEnumerable) de FuncionarioListagemViewModel *@
@model IEnumerable<FuncionarioListagemViewModel>

@{
	@* Define o título da página *@
	ViewData["Title"] = "Funcionários";
}

<!-- Cabeçalho principal da página com o título, descrição e botão de nova ação -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
	<div>
		<p class="text-uppercase small fw-semibold text-danger-emphasis mb-1">Cadastro</p>
		<h1 class="display-6 fw-bold mb-1">Funcionários</h1>
		<p class="text-body-secondary mb-0">Organize a equipe com salários, status e especialidades.</p>
	</div>

	@* Botão para acessar a tela de criação, vinculado à Action 'Criar' do Controller *@
	<a class="btn btn-danger btn-lg" asp-action="Criar">Novo funcionário</a>
</div>

@* Lógica Razor para verificar se existe algum item na lista do modelo *@
@if (Model?.Any() == true)
{
	<!-- Estrutura do card para encapsular a tabela e dar uma aparência mais limpa -->
	<div class="card border-danger-subtle shadow-sm">
		<div class="table-responsive">
			<!-- Tabela principal para listagem de dados -->
			<table class="table table-hover align-middle mb-0">
				<thead class="table-danger">
					<tr>
						<th>Id</th>
						<th>Nome</th>
						<th>Telefone</th>
						<th>Status</th>
						<th>Salário</th>
						<th>Especialidade</th>
						<th class="text-end">Ações</th>
					</tr>
				</thead>
				<tbody>
				@* Laço de repetição que itera por todos os funcionários e gera uma linha para cada um *@
				@foreach (var item in Model)
				{
					<tr>
						<td>@item.Id</td>
						<td class="fw-semibold">@item.Nome</td>
						<td>@item.Telefone</td>
						<td>@item.Status</td>
						@* Formata o salário como moeda usando ToString("C") *@
						<td>@item.Salario.ToString("C")</td>
						<td>@item.EspecialidadeNome</td>
						<td>
							<!-- Grupo de botões de ação para cada registro (Detalhes, Editar, Excluir) -->
							<div class="d-flex flex-wrap justify-content-end gap-2">
								@* TagHelpers asp-action definem a rota e asp-route-id envia o parâmetro de identificação *@
								<a class="btn btn-sm btn-outline-secondary" asp-action="Detalhes" asp-route-id="@item.Id">Detalhes</a>
								<a class="btn btn-sm btn-outline-danger" asp-action="Editar" asp-route-id="@item.Id">Editar</a>
								<a class="btn btn-sm btn-danger" asp-action="Excluir" asp-route-id="@item.Id">Excluir</a>
							</div>
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
else
{
	<!-- Caso a lista esteja vazia ou nula, exibe um alerta informando que não há registros -->
	<div class="alert alert-light border border-danger-subtle mb-0">
		Nenhum funcionário cadastrado.
	</div>
}
