@model FuncionarioRegistroViewModel

@{
    ViewData["Title"] = "Criar funcionário";
}

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card border-danger-subtle shadow-sm">
            <div class="card-header bg-danger-subtle border-danger-subtle">
                <h1 class="h3 mb-0 text-danger-emphasis">Criar funcionário</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="Criar" method="post" class="vstack gap-3">
                    <div asp-validation-summary="All" class="alert alert-danger mb-0" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefone" class="form-label"></label>
                            <input asp-for="Telefone" class="form-control" />
                            <span asp-validation-for="Telefone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<PessoaStatus>()"
                                    class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Salario" class="form-label"></label>
                            <input asp-for="Salario" class="form-control" />
                            <span asp-validation-for="Salario" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EspecialidadeId" class="form-label"></label>
                            <select asp-for="EspecialidadeId" asp-items="Model.EspecialidadesList" class="form-select">
                                <option value="">Selecione</option>
                            </select>
                            <span asp-validation-for="EspecialidadeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Senha" class="form-label"></label>
                            <input asp-for="Senha" class="form-control" />
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
                        <button type="submit" class="btn btn-danger">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>