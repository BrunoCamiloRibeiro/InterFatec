@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @* Bootstrap *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>@(ViewData["Title"] as string ?? "Fabys Unha")</title>
</head>

<body class="bg-body-secondary">
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg bg-danger-subtle border-bottom border-danger-subtle navbar-light">
            <div class="container-xxl">
                <a class="navbar-brand fw-semibold text-danger-emphasis" asp-controller="Home" asp-action="Index">Fabys Unha</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-lg-1">
                        @{
                            var tipoUsuario = Context.Session.GetString("UsuarioTipo");
                        }
                        
                        @if (string.IsNullOrEmpty(tipoUsuario))
                        {
                            <li class="nav-item">
                                <a class="nav-link rounded-pill px-lg-3" asp-controller="Login" asp-action="Index">Entrar / Cadastrar</a>
                            </li>
                        }
                        else
                        {
                            @if (tipoUsuario == "Cliente")
                            {
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Agendamentos" asp-action="Agendar">Agendar</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Agendamentos" asp-action="MeusAgendamentos">Meus Agendamentos</a>
                                </li>
                            }

                            @if (tipoUsuario == "Funcionario")
                            {
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Agendamentos" asp-action="Index">Painel Agendamentos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Clientes" asp-action="Index">Clientes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Funcionarios" asp-action="Index">Funcionários</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Especialidades" asp-action="Index">Especialidades</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Marcas" asp-action="Index">Marcas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Produtos" asp-action="Index">Produtos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Servicos" asp-action="Index">Serviços</a>
                                </li>
                            }
                            
                            <li class="nav-item ms-lg-3">
                                <a class="nav-link rounded-pill px-lg-3 bg-danger text-white" asp-controller="Login" asp-action="Logout">Sair</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-xxl py-4">
        @RenderBody()
    </main>

    @* Bootstrap *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('a.nav-link');

            navLinks.forEach(function (link) {
                const linkPath = new URL(link.href, window.location.origin).pathname;
                const isActive = currentPath === linkPath;

                link.classList.toggle('active', isActive);
                link.classList.toggle('bg-white', isActive);
                link.classList.toggle('text-danger-emphasis', isActive);

                if (isActive) {
                    link.setAttribute('aria-current', 'page');
                } else {
                    link.removeAttribute('aria-current');
                }
            });
        });
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>