@* Importa dependências, neste caso para ter acesso ao HttpContext.Session *@
@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<!-- O atributo data-bs-theme="light" define o tema claro do Bootstrap 5.3 -->
<html lang="pt-BR" data-bs-theme="light">

<head>
    <!-- Define a codificação e as configurações de viewport para dispositivos móveis -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @* Bootstrap: Inclusão do CSS via CDN *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Título da página definido na ViewData da View atual, com um valor padrão caso esteja nulo -->
    <title>@(ViewData["Title"] as string ?? "Fabys Unha")</title>
</head>

<body class="bg-body-secondary">
    <!-- Cabeçalho contendo a barra de navegação. 'sticky-top' a mantém fixa no topo da tela durante o rolamento -->
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg bg-danger-subtle border-bottom border-danger-subtle navbar-light">
            <div class="container-xxl">
                <!-- TagHelper 'asp-controller' e 'asp-action' cria a URL baseada na rota do framework (neste caso /Home/Index) -->
                <a class="navbar-brand fw-semibold text-danger-emphasis" asp-controller="Home" asp-action="Index">Fabys Unha</a>
                
                <!-- Botão 'hamburguer' que aparece em telas menores para colapsar o menu -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <!-- Container das opções do menu -->
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-lg-1">
                        @* Bloco Razor para ler informações da Sessão do Usuário logado *@
                        @{
                            var tipoUsuario = Context.Session.GetString("UsuarioTipo");
                        }
                        
                        @* Se o usuário não está logado (tipoUsuario nulo ou vazio), mostra a opção de 'Entrar/Cadastrar' *@
                        @if (string.IsNullOrEmpty(tipoUsuario))
                        {
                            <li class="nav-item">
                                <a class="nav-link rounded-pill px-lg-3" asp-controller="Login" asp-action="Index">Entrar / Cadastrar</a>
                            </li>
                        }
                        else
                        {
                            @* Opções do menu exclusivas para clientes *@
                            @if (tipoUsuario == "Cliente")
                            {
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Agendamentos" asp-action="Agendar">Agendar</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Agendamentos" asp-action="MeusAgendamentos">Meus Agendamentos</a>
                                </li>
                            }

                            @* Opções do menu exclusivas para funcionários (Painel Administrativo) *@
                            @if (tipoUsuario == "Funcionario")
                            {
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Agendamentos" asp-action="Index">Painel Agendamentos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Clientes" asp-action="Index">Clientes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Funcionarios" asp-action="Index">Funcionários</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Especialidades" asp-action="Index">Especialidades</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Marcas" asp-action="Index">Marcas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Produtos" asp-action="Index">Produtos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link rounded-pill px-lg-3" asp-controller="Servicos" asp-action="Index">Serviços</a>
                                </li>
                            }
                            
                            @* Ação comum para sair do sistema (Logout) *@
                            <li class="nav-item ms-lg-3">
                                <a class="nav-link rounded-pill px-lg-3 bg-danger text-white" asp-controller="Login" asp-action="Logout">Sair</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Ponto principal onde as Views chamadas pelos Controllers são renderizadas e inseridas neste Layout -->
    <main class="container-xxl py-4">
        @RenderBody()
    </main>

    <!-- Inclusão do JavaScript do Bootstrap via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script customizado para destacar a aba ativa do menu de navegação -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('a.nav-link');

            // Verifica as rotas dos links e adiciona/remove classes para efeito visual de "página atual"
            navLinks.forEach(function (link) {
                const linkPath = new URL(link.href, window.location.origin).pathname;
                const isActive = currentPath === linkPath;

                link.classList.toggle('active', isActive);
                link.classList.toggle('bg-white', isActive);
                link.classList.toggle('text-danger-emphasis', isActive);

                if (isActive) {
                    link.setAttribute('aria-current', 'page');
                } else {
                    link.removeAttribute('aria-current');
                }
            });
        });
    </script>

    @* 
        Abaixo, renderiza a seção opcional de Scripts (ex: Validação do lado do cliente) que cada View possa definir separadamente. 
        'required: false' indica que a view não é obrigada a usar/ter a seção Scripts.
    *@
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>