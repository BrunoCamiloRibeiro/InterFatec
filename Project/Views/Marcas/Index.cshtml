@model IEnumerable<MarcasViewModel>
@*
    A view Index geralmente exibe uma lista de itens.
    Por isso, o @model recebe uma coleção IEnumerable de MarcasViewModel.
*@

@{
    ViewData["Title"] = "Marcas";
}

<!-- Cabeçalho da página de listagem -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <p class="text-uppercase small fw-semibold text-danger-emphasis mb-1">Cadastro</p>
        <h1 class="display-6 fw-bold mb-1">Marcas</h1>
        <p class="text-body-secondary mb-0">Gerencie as marcas vinculadas aos produtos do sistema.</p>
    </div>

    <!-- 
        TagHelper asp-action="Criar" gera um link para a tela de criação de uma nova marca.
        Não precisamos especificar o controller pois já estamos na pasta (e contexto) de Marcas.
    -->
    <a class="btn btn-danger btn-lg" asp-action="Criar">Criar nova marca</a>
</div>

@* 
    Verifica se a lista (Model) não é nula e se possui pelo menos um item. 
    A sintaxe '?.' (null-conditional) evita erros caso Model seja nulo.
*@
@if (Model?.Any() == true)
{
    <!-- Se houver marcas cadastradas, exibe a tabela -->
    <div class="card border-danger-subtle shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-danger">
                    <tr>
                        <th>Id</th>
                        <th>Nome</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @* 
                    O foreach percorre cada item da coleção (Model).
                    Para cada 'item', renderiza uma linha <tr> na tabela HTML.
                *@
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- Sintaxe Razor @@item.Propriedade para injetar valores do C# no HTML -->
                        <td>@item.Id</td>
                        <td class="fw-semibold">@item.Nome</td>
                        <td>@item.Status</td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                <!-- 
                                    A TagHelper asp-route-id adiciona o Id do item na URL como um parâmetro de rota.
                                    Exemplo de URL gerada: /Marcas/Editar/5
                                -->
                                <a class="btn btn-sm btn-outline-danger" asp-action="Editar" asp-route-id="@item.Id">Editar</a>
                                <a class="btn btn-sm btn-danger" asp-action="Excluir" asp-route-id="@item.Id">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <!-- Caso a lista esteja vazia, mostra uma mensagem amigável no lugar da tabela -->
    <div class="alert alert-light border border-danger-subtle mb-0">
        Nenhuma marca cadastrada.
    </div>
}