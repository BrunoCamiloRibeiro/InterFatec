@model ClienteDetalhesViewModel

@{
    ViewData["Title"] = "Detalhes do cliente";
}

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card border-danger-subtle shadow-sm">
            <div class="card-header bg-danger-subtle border-danger-subtle d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <h1 class="h3 mb-1 text-danger-emphasis">Detalhes do cliente</h1>
                    <p class="mb-0 text-body-secondary">Resumo com dados cadastrais e histórico dos agendamentos.</p>
                </div>

                <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">#@Model.Id</span>
            </div>

            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-body-secondary">Nome</dt>
                    <dd class="col-sm-8">@Model.Nome</dd>

                    <dt class="col-sm-4 text-body-secondary">Telefone</dt>
                    <dd class="col-sm-8">@Model.Telefone</dd>

                    <dt class="col-sm-4 text-body-secondary">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>

                    <dt class="col-sm-4 text-body-secondary">Total de agendamentos</dt>
                    <dd class="col-sm-8">@Model.TotalAgendamentos</dd>

                    <dt class="col-sm-4 text-body-secondary">Último agendamento</dt>
                    <dd class="col-sm-8 mb-0">@(Model.DataUltimoAgendamento?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                </dl>

                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-danger" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
                    <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
                </div>
            </div>
        </div>
    </div>
</div>