@* Define o modelo que esta view irá utilizar para receber os dados do formulário *@
@model ClienteRegistroViewModel

@{
    @* Define o título da página no dicionário ViewData, que será usado no layout principal *@
    ViewData["Title"] = "Criar cliente";
}

<!-- Container principal para centralizar o formulário na tela -->
<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-danger-subtle shadow-sm">
            <div class="card-header bg-danger-subtle border-danger-subtle">
                <h1 class="h3 mb-0 text-danger-emphasis">Criar cliente</h1>
            </div>
            <div class="card-body p-4">
                <!-- Formulário para envio dos dados. 
                     asp-action="Criar": indica que os dados serão enviados para a action "Criar" do controller atual.
                     method="post": define o método HTTP POST para o envio. -->
                <form asp-action="Criar" method="post" class="vstack gap-3">
                    <!-- TagHelper para exibir o resumo das mensagens de validação (erros do ModelState) -->
                    <div asp-validation-summary="All" class="alert alert-danger mb-0" role="alert"></div>

                    <div>
                        <!-- TagHelpers vinculados à propriedade "Nome" do modelo. 
                             asp-for gera o id, o name, e o valor adequado para o input e o label. -->
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <!-- TagHelper que exibe mensagens de erro específicas para o campo "Nome" -->
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="Telefone" class="form-label"></label>
                        <input asp-for="Telefone" class="form-control" />
                        <span asp-validation-for="Telefone" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="Status" class="form-label"></label>
                        <!-- asp-items recebe uma lista de opções gerada a partir do enum PessoaStatus -->
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<PessoaStatus>()" class="form-select"></select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="Senha" class="form-label"></label>
                        <input asp-for="Senha" class="form-control" type="password" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <!-- Link para voltar à lista de clientes (action "Index") -->
                        <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
                        <!-- Botão de submit para disparar o envio do formulário -->
                        <button type="submit" class="btn btn-danger">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>