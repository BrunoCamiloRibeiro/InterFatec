@model ServicoDetalhesViewModel

@{
    ViewData["Title"] = "Excluir serviço";
}

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card border-danger-subtle shadow-sm">
            <div class="card-header bg-danger-subtle border-danger-subtle">
                <h1 class="h3 mb-0 text-danger-emphasis">Excluir serviço</h1>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-danger mb-4" role="alert">
                    Tem certeza que deseja excluir este serviço? Esta ação não pode ser desfeita.
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-body-secondary">Id</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4 text-body-secondary">Descrição</dt>
                    <dd class="col-sm-8">@Model.Descricao</dd>

                    <dt class="col-sm-4 text-body-secondary">Preço</dt>
                    <dd class="col-sm-8">@Model.PrecoFormatado</dd>

                    <dt class="col-sm-4 text-body-secondary">Tempo</dt>
                    <dd class="col-sm-8">@Model.TempoFormatado</dd>

                    <dt class="col-sm-4 text-body-secondary">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>

                <form asp-action="Excluir" method="post" class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                    <input type="hidden" asp-for="Id" />
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
                </form>
            </div>
        </div>
    </div>
</div>