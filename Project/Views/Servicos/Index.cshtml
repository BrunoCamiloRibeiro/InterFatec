@model IEnumerable<ServicoListagemViewModel>

@{
	ViewData["Title"] = "Serviços";
}

<!-- Cabeçalho da página de listagem, usando Flexbox para separar o título do botão de criação -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
	<div>
		<p class="text-uppercase small fw-semibold text-danger-emphasis mb-1">Cadastro</p>
		<h1 class="display-6 fw-bold mb-1">Serviços</h1>
		<p class="text-body-secondary mb-0">Gerencie os serviços oferecidos com preço, duração e status.</p>
	</div>

	<!-- O TagHelper 'asp-action="Criar"' leva à página com o formulário de cadastro de um novo serviço -->
	<a class="btn btn-danger btn-lg" asp-action="Criar">Novo serviço</a>
</div>

@* Verifica se a lista do Modelo contém itens. Se sim, renderiza a tabela de serviços. *@
@if (Model?.Any() == true)
{
	<div class="card border-danger-subtle shadow-sm">
		<!-- Tabela responsiva (aparecerá barra de rolagem horizontal se não couber na tela) -->
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-danger">
					<tr>
						<th>Id</th>
						<th>Descrição</th>
						<th>Preço</th>
						<th>Duração</th>
						<th>Status</th>
						<!-- Alinha as ações (botões) à direita -->
						<th class="text-end">Ações</th>
					</tr>
				</thead>
				<tbody>
				@* Laço de repetição (foreach) Razor para iterar sobre a coleção de serviços contida em 'Model' *@
				@foreach (var item in Model)
				{
					<tr>
						<!-- Apresenta os dados do respectivo item na tabela -->
						<td>@item.Id</td>
						<td class="fw-semibold">@item.Descricao</td>
						<td>@item.PrecoFormatado</td>
						<td>@item.TempoFormatado</td>
						<td>@item.Status</td>
						<td>
							<!-- Grupo de botões de Ações vinculados ao ID daquele serviço específico -->
							<div class="d-flex flex-wrap justify-content-end gap-2">
								<!-- 'asp-route-id' anexa o ID como um parâmetro na URL para cada Action correspondente -->
								<a class="btn btn-sm btn-outline-secondary" asp-action="Detalhes" asp-route-id="@item.Id">Detalhes</a>
								<a class="btn btn-sm btn-outline-danger" asp-action="Editar" asp-route-id="@item.Id">Editar</a>
								<a class="btn btn-sm btn-danger" asp-action="Excluir" asp-route-id="@item.Id">Excluir</a>
							</div>
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
else
{
	<!-- Bloco exibido caso não haja nenhum serviço cadastrado (Model nulo ou vazio) -->
	<div class="alert alert-light border border-danger-subtle mb-0">
		Nenhum serviço cadastrado.
	</div>
}
