@* O modelo EspecialidadeViewModel carrega os dados atuais para serem alterados *@
@model EspecialidadeViewModel

@{
    ViewData["Title"] = "Editar Especialidade";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-danger-subtle shadow-sm">
            <div class="card-header bg-danger-subtle border-danger-subtle">
                <h1 class="h3 mb-0 text-danger-emphasis">Editar especialidade</h1>
            </div>
            <div class="card-body p-4">
                <!-- Formulário com método POST disparando a Action Editar do EspecialidadesController -->
                <form asp-action="Editar" method="post" class="vstack gap-3">
                    <!-- O ID não deve ser alterado pelo usuário, mas precisa ser enviado ao controller, por isso fica oculto -->
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="alert alert-danger mb-0" role="alert"></div>

                    <div>
                        <label asp-for="Descricao" class="form-label"></label>
                        <input asp-for="Descricao" class="form-control" />
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<PessoaStatus>()" class="form-select"></select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <!-- O atributo asp-action="Index" gera o href apontando para a listagem -->
                        <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
                        <button type="submit" class="btn btn-danger">Salvar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
