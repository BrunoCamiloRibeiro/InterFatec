@* O Model é uma lista de objetos EspecialidadeViewModel *@
@model IEnumerable<EspecialidadeViewModel>

@{
	ViewData["Title"] = "Especialidades";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
	<div>
		<p class="text-uppercase small fw-semibold text-danger-emphasis mb-1">Cadastro</p>
		<h1 class="display-6 fw-bold mb-1">Especialidades</h1>
		<p class="text-body-secondary mb-0">Organize as especialidades usadas para vincular os funcionários.</p>
	</div>

	<!-- Link para criar um novo registro -->
	<a class="btn btn-danger btn-lg" asp-action="Criar">Nova especialidade</a>
</div>

@* Verifica se o Model (a lista) tem pelo menos um item usando LINQ (Any) *@
@if (Model?.Any() == true)
{
	<div class="card border-danger-subtle shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-danger">
					<tr>
						<th>Id</th>
						<th>Nome</th>
						<th>Status</th>
						<th class="text-end">Ações</th>
					</tr>
				</thead>
				<tbody>
				@* Laço de repetição (foreach) para gerar dinamicamente as linhas (<tr>) da tabela baseadas no Model *@
				@foreach (var item in Model)
				{
					<tr>
						<!-- Exibe as propriedades de cada item da lista iterada -->
						<td>@item.Id</td>
						<td class="fw-semibold">@item.Descricao</td>
						<td>@item.Status</td>
						<td class="text-end">
							<div class="btn-group btn-group-sm" role="group">
								<!-- O asp-route-id envia o Id da especialidade como parâmetro na URL para as actions Editar/Excluir -->
								<a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
									Editar
								</a>
								<a asp-action="Excluir" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Excluir">
									Excluir
								</a>
							</div>
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
}
else
{
	@* Se a lista estiver vazia, exibe um bloco informando a ausência de dados *@
	<div class="alert alert-light border border-danger-subtle mb-0">
		Nenhuma especialidade cadastrada.
	</div>
}