@model IEnumerable<EspecialidadeViewModel>

@{
	ViewData["Title"] = "Especialidades";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
	<div>
		<p class="text-uppercase small fw-semibold text-danger-emphasis mb-1">Cadastro</p>
		<h1 class="display-6 fw-bold mb-1">Especialidades</h1>
		<p class="text-body-secondary mb-0">Organize as especialidades usadas para vincular os funcionários.</p>
	</div>

	<a class="btn btn-danger btn-lg" asp-action="Criar">Nova especialidade</a>
</div>

@if (Model?.Any() == true)
{
	<div class="card border-danger-subtle shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-danger">
					<tr>
						<th>Id</th>
						<th>Nome</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>@item.Id</td>
						<td class="fw-semibold">@item.Descricao</td>
						<td>@item.Status</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
else
{
	<div class="alert alert-light border border-danger-subtle mb-0">
		Nenhuma especialidade cadastrada.
	</div>
}