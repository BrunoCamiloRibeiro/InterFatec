@model AgendamentoDetalhesViewModel

@{
    ViewData["Title"] = "Detalhes do agendamento";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <p class="text-uppercase small fw-semibold text-danger-emphasis mb-1">Agenda</p>
        <h1 class="display-6 fw-bold mb-1">Detalhes do agendamento</h1>
        <p class="text-body-secondary mb-0">Resumo completo com serviços e produtos vinculados ao atendimento.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-danger" asp-action="Editar" asp-route-id="@Model.Nr">Editar</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-5">
        <div class="card border-danger-subtle shadow-sm h-100">
            <div class="card-header bg-danger-subtle border-danger-subtle d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Resumo</h2>
                <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">#@Model.Nr</span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-body-secondary">Cliente</dt>
                    <dd class="col-sm-7">@Model.ClienteNome</dd>

                    <dt class="col-sm-5 text-body-secondary">Data e hora</dt>
                    <dd class="col-sm-7">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5 text-body-secondary">Status</dt>
                    <dd class="col-sm-7">@Model.Status</dd>

                    <dt class="col-sm-5 text-body-secondary">Total</dt>
                    <dd class="col-sm-7 mb-0">@Model.Total.ToString("C")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="card border-danger-subtle shadow-sm mb-4">
            <div class="card-header bg-danger-subtle border-danger-subtle">
                <h2 class="h5 mb-0">Serviços</h2>
            </div>
            <div class="card-body p-0">
                @if (Model.ServicosAgendados.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-danger">
                                <tr>
                                    <th>Serviço</th>
                                    <th>Funcionário</th>
                                    <th>Horário</th>
                                    <th>Observação</th>
                                    <th>Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.ServicosAgendados)
                            {
                                <tr>
                                    <td>@item.ServicoNome</td>
                                    <td>@item.FuncionarioNome</td>
                                    <td>@(TimeSpan.TryParse(item.Horario, out var ts) ? ts.ToString(@"hh\:mm") : item.Horario)</td>
                                    <td>@item.Obs</td>
                                    <td>@item.Valor.ToString("C")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-body-secondary">Sem serviços.</div>
                }
            </div>
        </div>

        <div class="card border-danger-subtle shadow-sm">
            <div class="card-header bg-danger-subtle border-danger-subtle">
                <h2 class="h5 mb-0">Produtos</h2>
            </div>
            <div class="card-body p-0">
                @if (Model.ProdutosAgendados.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-danger">
                                <tr>
                                    <th>Produto</th>
                                    <th>Serviço</th>
                                    <th>Preço</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.ProdutosAgendados)
                            {
                                <tr>
                                    <td>@item.ProdutoNome</td>
                                    <td>@item.ServicoNome</td>
                                    <td>@item.Preco.ToString("C")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-body-secondary">Sem produtos.</div>
                }
            </div>
        </div>
    </div>
</div>