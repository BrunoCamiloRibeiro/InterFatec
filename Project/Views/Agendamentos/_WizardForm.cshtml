@model AgendamentoRegistroViewModel

@{
    var isEdit = Model is AgendamentoEditarViewModel;
    var formAction = ViewData["WizardAction"] as string ?? (isEdit ? "Editar" : "Criar");
    var submitText = ViewData["WizardSubmitText"] as string ?? (isEdit ? "Salvar alterações" : "Salvar agendamento");
    var pageTitle = ViewData["WizardTitle"] as string ?? (isEdit ? "Editar agendamento" : "Criar agendamento");

    var serviceItems = Model.ServicosSelecionados.Count > 0
        ? Model.ServicosSelecionados
        : new List<ServicoAgendadoViewModel> { new ServicoAgendadoViewModel() };

    var productItems = Model.ProdutosSelecionados.Count > 0
        ? Model.ProdutosSelecionados
        : new List<ProdutoAgendadoViewModel> { new ProdutoAgendadoViewModel() };
}

<div class="card border-danger-subtle shadow-sm">
    <div class="card-header bg-danger-subtle border-danger-subtle d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2">
        <div>
            <h1 class="h3 mb-1 text-danger-emphasis">@pageTitle</h1>
            <p class="mb-0 text-body-secondary">Use as etapas para cadastrar cliente, serviços e produtos com mais clareza.</p>
        </div>

        <span class="badge text-bg-danger align-self-start align-self-lg-center" id="wizard-step-indicator">Etapa 1 de 4</span>
    </div>

    <div class="card-body p-4">
        <form asp-action="@formAction" method="post" id="agendamento-wizard-form" class="vstack gap-4">
            @if (Model is AgendamentoEditarViewModel editarModel)
            {
                <input type="hidden" name="Nr" value="@editarModel.Nr" />
            }

            <div asp-validation-summary="All" class="alert alert-danger mb-0" role="alert"></div>

            <div class="d-flex flex-wrap gap-2" id="wizard-step-buttons">
                <button type="button" class="btn btn-danger" data-step-button="0">1. Dados</button>
                <button type="button" class="btn btn-outline-danger" data-step-button="1">2. Serviços</button>
                <button type="button" class="btn btn-outline-danger" data-step-button="2">3. Produtos</button>
                <button type="button" class="btn btn-outline-danger" data-step-button="3">4. Revisão</button>
            </div>

            <section class="wizard-step" data-wizard-step="0">
                <div class="row g-3">
                    <div class="col-lg-5">
                        <label asp-for="ClienteId" class="form-label"></label>
                        <select asp-for="ClienteId" asp-items="Model.ClientesList" class="form-select">
                            <option value="">Selecione</option>
                        </select>
                        <span asp-validation-for="ClienteId" class="text-danger small"></span>
                    </div>

                    <div class="col-lg-4">
                        <label asp-for="DataHora" class="form-label"></label>
                        <input asp-for="DataHora" type="datetime-local" value="@(Model.DataHora == default ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm") : Model.DataHora.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
                        <span asp-validation-for="DataHora" class="text-danger small"></span>
                    </div>

                    <div class="col-lg-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<AgendamentoStatus>()" class="form-select"></select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="button" class="btn btn-danger" data-wizard-next>Próximo</button>
                </div>
            </section>

            <section class="wizard-step d-none" data-wizard-step="1">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
                    <div>
                        <h2 class="h4 mb-1">Serviços</h2>
                        <p class="text-body-secondary mb-0">Adicione um ou mais serviços com o funcionário responsável e o horário de atendimento.</p>
                    </div>

                    <button type="button" class="btn btn-outline-danger" id="add-service">Adicionar serviço</button>
                </div>

                <div id="service-rows" class="vstack gap-3">
                    @for (var i = 0; i < serviceItems.Count; i++)
                    {
                        var item = serviceItems[i];
                        var servicosOptions = (Model.ServicosList ?? Enumerable.Empty<SelectListItem>())
                            .Select(option => new SelectListItem { Text = option.Text, Value = option.Value, Selected = option.Value == item.ServicoId.ToString() })
                            .ToList();

                        var funcionariosOptions = (Model.FuncionariosList ?? Enumerable.Empty<SelectListItem>())
                            .Select(option => new SelectListItem { Text = option.Text, Value = option.Value, Selected = option.Value == item.FuncionarioId.ToString() })
                            .ToList();

                        var servicePrefix = $"ServicosSelecionados[{i}]";

                        <div class="js-service-row card border-danger-subtle bg-body-tertiary">
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-lg-4">
                                        <label class="form-label">Serviço</label>
                                        <select data-field="ServicoId" name="@($"{servicePrefix}.ServicoId")" asp-items="servicosOptions" class="form-select">
                                            <option value="">Selecione</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-3">
                                        <label class="form-label">Funcionário</label>
                                        <select data-field="FuncionarioId" name="@($"{servicePrefix}.FuncionarioId")" asp-items="funcionariosOptions" class="form-select">
                                            <option value="">Selecione</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-2">
                                        <label class="form-label">Horário</label>
                                        <input data-field="Horario" type="time" name="@($"{servicePrefix}.Horario")" value="@(string.IsNullOrEmpty(item.Horario) ? string.Empty : TimeSpan.TryParse(item.Horario, out var tsForm) ? new DateTime(tsForm.Ticks).ToString("HH:mm") : item.Horario)" class="form-control" />
                                    </div>

                                    <div class="col-lg-2">
                                        <label class="form-label">Observação</label>
                                        <input data-field="Obs" type="text" name="@($"{servicePrefix}.Obs")" value="@item.Obs" class="form-control" />
                                    </div>

                                    <div class="col-lg-1 d-grid">
                                        <button type="button" class="btn btn-outline-danger js-remove-row">Remover</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <template id="service-template">
                    <div class="js-service-row card border-danger-subtle bg-body-tertiary">
                        <div class="card-body">
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-4">
                                    <label class="form-label">Serviço</label>
                                    <select data-field="ServicoId" asp-items="Model.ServicosList" class="form-select">
                                        <option value="">Selecione</option>
                                    </select>
                                </div>

                                <div class="col-lg-3">
                                    <label class="form-label">Funcionário</label>
                                    <select data-field="FuncionarioId" asp-items="Model.FuncionariosList" class="form-select">
                                        <option value="">Selecione</option>
                                    </select>
                                </div>

                                <div class="col-lg-2">
                                    <label class="form-label">Horário</label>
                                    <input data-field="Horario" type="time" class="form-control" />
                                </div>

                                <div class="col-lg-2">
                                    <label class="form-label">Observação</label>
                                    <input data-field="Obs" type="text" class="form-control" />
                                </div>

                                <div class="col-lg-1 d-grid">
                                    <button type="button" class="btn btn-outline-danger js-remove-row">Remover</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-danger" data-wizard-prev>Anterior</button>
                    <button type="button" class="btn btn-danger" data-wizard-next>Próximo</button>
                </div>
            </section>

            <section class="wizard-step d-none" data-wizard-step="2">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
                    <div>
                        <h2 class="h4 mb-1">Produtos</h2>
                        <p class="text-body-secondary mb-0">Inclua os produtos usados no atendimento e associe cada item ao serviço correspondente.</p>
                    </div>

                    <button type="button" class="btn btn-outline-danger" id="add-product">Adicionar produto</button>
                </div>

                <div id="product-rows" class="vstack gap-3">
                    @for (var i = 0; i < productItems.Count; i++)
                    {
                        var item = productItems[i];
                        var produtosOptions = (Model.ProdutosList ?? Enumerable.Empty<SelectListItem>())
                            .Select(option => new SelectListItem { Text = option.Text, Value = option.Value, Selected = option.Value == item.ProdutoCodigo.ToString() })
                            .ToList();

                        var produtoServicoOptions = (Model.ServicosList ?? Enumerable.Empty<SelectListItem>())
                            .Select(option => new SelectListItem { Text = option.Text, Value = option.Value, Selected = option.Value == item.ServicoId.ToString() })
                            .ToList();

                        var productPrefix = $"ProdutosSelecionados[{i}]";

                        <div class="js-product-row card border-danger-subtle bg-body-tertiary">
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-lg-5">
                                        <label class="form-label">Produto</label>
                                        <select data-field="ProdutoCodigo" name="@($"{productPrefix}.ProdutoCodigo")" asp-items="produtosOptions" class="form-select">
                                            <option value="">Selecione</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-6">
                                        <label class="form-label">Serviço</label>
                                        <select data-field="ServicoId" name="@($"{productPrefix}.ServicoId")" asp-items="produtoServicoOptions" class="form-select">
                                            <option value="">Selecione</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-1 d-grid">
                                        <button type="button" class="btn btn-outline-danger js-remove-row">Remover</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <template id="product-template">
                    <div class="js-product-row card border-danger-subtle bg-body-tertiary">
                        <div class="card-body">
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-5">
                                    <label class="form-label">Produto</label>
                                    <select data-field="ProdutoCodigo" asp-items="Model.ProdutosList" class="form-select">
                                        <option value="">Selecione</option>
                                    </select>
                                </div>

                                <div class="col-lg-6">
                                    <label class="form-label">Serviço</label>
                                    <select data-field="ServicoId" asp-items="Model.ServicosList" class="form-select">
                                        <option value="">Selecione</option>
                                    </select>
                                </div>

                                <div class="col-lg-1 d-grid">
                                    <button type="button" class="btn btn-outline-danger js-remove-row">Remover</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-danger" data-wizard-prev>Anterior</button>
                    <button type="button" class="btn btn-danger" data-wizard-next>Próximo</button>
                </div>
            </section>

            <section class="wizard-step d-none" data-wizard-step="3">
                <div class="row g-3">
                    <div class="col-lg-7">
                        <div class="card border-danger-subtle h-100">
                            <div class="card-header bg-danger-subtle border-danger-subtle">
                                <h2 class="h5 mb-0">Resumo do agendamento</h2>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Cliente</span>
                                        <strong id="summary-client">-</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Data e hora</span>
                                        <strong id="summary-datetime">-</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Status</span>
                                        <strong id="summary-status">-</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Serviços</span>
                                        <strong id="summary-service-count">0</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Produtos</span>
                                        <strong id="summary-product-count">0</strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card border-danger-subtle bg-danger-subtle h-100">
                            <div class="card-body d-flex flex-column gap-3">
                                <div>
                                    <h2 class="h5 mb-2">Conferência final</h2>
                                    <p class="mb-0 text-body-secondary">Reveja as informações antes de salvar. Se algo estiver errado, volte para a etapa correspondente e ajuste os itens.</p>
                                </div>

                                <div class="alert alert-light border-danger-subtle mb-0">
                                    O cadastro será enviado com tudo em uma única submissão, mantendo a experiência guiada do wizard.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-danger" data-wizard-prev>Anterior</button>
                    <button type="submit" class="btn btn-danger btn-lg">@submitText</button>
                </div>
            </section>
        </form>
    </div>
</div>

<script>
    (function () {
        function renumberRows(containerId, rowSelector, prefix) {
            const container = document.getElementById(containerId);
            if (!container) {
                return;
            }

            const rows = container.querySelectorAll(rowSelector);
            rows.forEach(function (row, index) {
                row.querySelectorAll('[data-field]').forEach(function (element) {
                    element.name = prefix + '[' + index + '].' + element.dataset.field;
                });
            });
        }

        const steps = Array.from(document.querySelectorAll('[data-wizard-step]'));
        if (!steps.length) {
            return;
        }

        const stepButtons = Array.from(document.querySelectorAll('[data-step-button]'));
        const stepIndicator = document.getElementById('wizard-step-indicator');
        const clientSelect = document.getElementById('ClienteId');
        const dateInput = document.getElementById('DataHora');
        const statusSelect = document.getElementById('Status');
        const summaryClient = document.getElementById('summary-client');
        const summaryDateTime = document.getElementById('summary-datetime');
        const summaryStatus = document.getElementById('summary-status');
        const summaryServiceCount = document.getElementById('summary-service-count');
        const summaryProductCount = document.getElementById('summary-product-count');
        const serviceContainer = document.getElementById('service-rows');
        const productContainer = document.getElementById('product-rows');
        const addServiceButton = document.getElementById('add-service');
        const addProductButton = document.getElementById('add-product');

        let currentStep = 0;

        function selectedText(selectElement) {
            if (!selectElement || selectElement.selectedIndex < 0) {
                return '-';
            }

            const option = selectElement.options[selectElement.selectedIndex];
            return option && option.value ? option.textContent.trim() : '-';
        }

        function formatDateTime(value) {
            if (!value) {
                return '-';
            }

            const date = new Date(value);
            if (Number.isNaN(date.getTime())) {
                return value;
            }

            return new Intl.DateTimeFormat('pt-BR', {
                dateStyle: 'short',
                timeStyle: 'short'
            }).format(date);
        }

        function updateSummary() {
            if (summaryClient) {
                summaryClient.textContent = selectedText(clientSelect);
            }

            if (summaryDateTime) {
                summaryDateTime.textContent = formatDateTime(dateInput ? dateInput.value : '');
            }

            if (summaryStatus) {
                summaryStatus.textContent = selectedText(statusSelect);
            }

            if (summaryServiceCount && serviceContainer) {
                summaryServiceCount.textContent = serviceContainer.querySelectorAll('.js-service-row').length.toString();
            }

            if (summaryProductCount && productContainer) {
                summaryProductCount.textContent = productContainer.querySelectorAll('.js-product-row').length.toString();
            }
        }

        function setStep(step) {
            currentStep = Math.max(0, Math.min(step, steps.length - 1));

            steps.forEach(function (pane, index) {
                pane.classList.toggle('d-none', index !== currentStep);
            });

            stepButtons.forEach(function (button) {
                const buttonStep = Number(button.dataset.stepButton);
                const isActive = buttonStep === currentStep;

                button.classList.toggle('btn-danger', isActive);
                button.classList.toggle('btn-outline-danger', !isActive);
                button.setAttribute('aria-current', isActive ? 'step' : 'false');
            });

            if (stepIndicator) {
                stepIndicator.textContent = 'Etapa ' + (currentStep + 1) + ' de ' + steps.length;
            }

            updateSummary();
        }

        function closestStepWithError() {
            const errorPane = steps.findIndex(function (pane) {
                return pane.querySelector('.field-validation-error') !== null;
            });

            return errorPane >= 0 ? errorPane : 0;
        }

        function addRow(templateId, containerId, rowSelector, prefix) {
            const container = document.getElementById(containerId);
            const template = document.getElementById(templateId);
            if (!container || !template) {
                return;
            }

            container.appendChild(template.content.cloneNode(true));
            renumberRows(containerId, rowSelector, prefix);
            updateSummary();
        }

        function hookStepperButtons() {
            document.querySelectorAll('[data-wizard-next]').forEach(function (button) {
                button.addEventListener('click', function () {
                    setStep(currentStep + 1);
                });
            });

            document.querySelectorAll('[data-wizard-prev]').forEach(function (button) {
                button.addEventListener('click', function () {
                    setStep(currentStep - 1);
                });
            });

            stepButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    setStep(Number(button.dataset.stepButton));
                });
            });
        }

        function hookDynamicRows() {
            if (addServiceButton) {
                addServiceButton.addEventListener('click', function () {
                    addRow('service-template', 'service-rows', '.js-service-row', 'ServicosSelecionados');
                });
            }

            if (addProductButton) {
                addProductButton.addEventListener('click', function () {
                    addRow('product-template', 'product-rows', '.js-product-row', 'ProdutosSelecionados');
                });
            }

            if (serviceContainer) {
                serviceContainer.addEventListener('click', function (event) {
                    const target = event.target;
                    if (!(target instanceof HTMLElement) || !target.classList.contains('js-remove-row')) {
                        return;
                    }

                    const rows = serviceContainer.querySelectorAll('.js-service-row');
                    if (rows.length <= 1) {
                        return;
                    }

                    const row = target.closest('.js-service-row');
                    if (row) {
                        row.remove();
                        renumberRows('service-rows', '.js-service-row', 'ServicosSelecionados');
                        updateSummary();
                    }
                });
            }

            if (productContainer) {
                productContainer.addEventListener('click', function (event) {
                    const target = event.target;
                    if (!(target instanceof HTMLElement) || !target.classList.contains('js-remove-row')) {
                        return;
                    }

                    const rows = productContainer.querySelectorAll('.js-product-row');
                    if (rows.length <= 1) {
                        return;
                    }

                    const row = target.closest('.js-product-row');
                    if (row) {
                        row.remove();
                        renumberRows('product-rows', '.js-product-row', 'ProdutosSelecionados');
                        updateSummary();
                    }
                });
            }

            renumberRows('service-rows', '.js-service-row', 'ServicosSelecionados');
            renumberRows('product-rows', '.js-product-row', 'ProdutosSelecionados');
        }

        function hookSummaryInputs() {
            [clientSelect, dateInput, statusSelect].forEach(function (input) {
                if (!input) {
                    return;
                }

                input.addEventListener('change', updateSummary);
                input.addEventListener('input', updateSummary);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            hookStepperButtons();
            hookDynamicRows();
            hookSummaryInputs();
            updateSummary();
            setStep(closestStepWithError());
        });
    })();
</script>