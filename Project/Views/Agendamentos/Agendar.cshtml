@model AgendamentoClienteViewModel

@{
    ViewData["Title"] = "Agendar — Faby's Unha";
}

<div class="card border-danger-subtle shadow-sm">
    <div class="card-header bg-danger-subtle border-danger-subtle d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2">
        <div>
            <h1 class="h3 mb-1 text-danger-emphasis">Agendar atendimento</h1>
            <p class="mb-0 text-body-secondary">Monte seu agendamento escolhendo serviços, horários e produtos.</p>
        </div>
        <span class="badge text-bg-danger align-self-start align-self-lg-center" id="wizard-step-indicator">Etapa 1 de 3</span>
    </div>

    <div class="card-body p-4">
        <form asp-action="Agendar" method="post" id="client-wizard-form" class="vstack gap-4">

            <div asp-validation-summary="All" class="alert alert-danger mb-0" role="alert"></div>

            <div class="d-flex flex-wrap gap-2" id="wizard-step-buttons">
                <button type="button" class="btn btn-danger" data-step-button="0">1. Serviços</button>
                <button type="button" class="btn btn-outline-danger" data-step-button="1">2. Identificação</button>
                <button type="button" class="btn btn-outline-danger" data-step-button="2">3. Revisão</button>
            </div>

            @* ============================== ETAPA 1 — SERVIÇOS ============================== *@
            <section class="wizard-step" data-wizard-step="0">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3">
                    <div>
                        <h2 class="h4 mb-1">Serviços</h2>
                        <p class="text-body-secondary mb-0">Adicione os serviços desejados. Em cada serviço, escolha quem irá atender, a data, o horário e os produtos.</p>
                    </div>
                    <button type="button" class="btn btn-outline-danger" id="add-service-client">Adicionar serviço</button>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Data do atendimento</label>
                    <input asp-for="Data" type="date" id="client-data"
                        min="@DateTime.Now.ToString("yyyy-MM-dd")"
                        max="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")"
                        value="@(Model.Data == default ? DateTime.Now.ToString("yyyy-MM-dd") : Model.Data.ToString("yyyy-MM-dd"))"
                        class="form-control" style="max-width: 250px;" />
                    <span asp-validation-for="Data" class="text-danger small"></span>
                </div>

                <div id="service-client-rows" class="vstack gap-4">
                    @{
                        var svcItems = Model.Servicos.Count > 0
                            ? Model.Servicos
                            : new List<ServicoClienteItemViewModel> { new ServicoClienteItemViewModel() };
                    }
                    @for (var i = 0; i < svcItems.Count; i++)
                    {
                        var item = svcItems[i];
                        var prefix = $"Servicos[{i}]";

                        var servicosOptions = (Model.ServicosList ?? Enumerable.Empty<SelectListItem>())
                            .Select(o => new SelectListItem { Text = o.Text, Value = o.Value, Selected = o.Value == item.ServicoId.ToString() })
                            .ToList();
                        var funcOptions = (Model.FuncionariosList ?? Enumerable.Empty<SelectListItem>())
                            .Select(o => new SelectListItem { Text = o.Text, Value = o.Value, Selected = o.Value == item.FuncionarioId.ToString() })
                            .ToList();

                        <div class="js-svc-client-row card border-danger-subtle">
                            <div class="card-header bg-danger-subtle border-danger-subtle d-flex justify-content-between align-items-center">
                                <span class="fw-semibold text-danger-emphasis js-svc-title">Serviço #@(i + 1)</span>
                                <button type="button" class="btn btn-sm btn-outline-danger js-remove-svc">Remover</button>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-lg-6">
                                        <label class="form-label">Serviço</label>
                                        <select data-field="ServicoId" name="@($"{prefix}.ServicoId")" asp-items="servicosOptions" class="form-select">
                                            <option value="">Selecione o serviço</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-label">Profissional</label>
                                        <select data-field="FuncionarioId" name="@($"{prefix}.FuncionarioId")" asp-items="funcOptions" class="form-select js-func-select">
                                            <option value="">Selecione o profissional</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-4">
                                        <label class="form-label">Horário disponível</label>
                                        <select data-field="Horario" name="@($"{prefix}.Horario")" class="form-select js-horario-select">
                                            <option value="">Selecione profissional e data</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-8">
                                        <label class="form-label">Observação</label>
                                        <input data-field="Obs" name="@($"{prefix}.Obs")" type="text" value="@item.Obs" class="form-control" placeholder="Alguma observação? (opcional)" />
                                    </div>
                                </div>

                                <hr class="my-3 border-danger-subtle" />

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold text-body-secondary">Produtos (opcional)</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary js-add-product-btn">Adicionar produto</button>
                                </div>
                                <div class="js-product-list vstack gap-2">
                                    @if (item.ProdutosCodigos != null)
                                    {
                                        for (var j = 0; j < item.ProdutosCodigos.Count; j++)
                                        {
                                            var prodCode = item.ProdutosCodigos[j];
                                            var prodOptions = (Model.ProdutosList ?? Enumerable.Empty<SelectListItem>())
                                                .Select(o => new SelectListItem { Text = o.Text, Value = o.Value, Selected = o.Value == prodCode.ToString() })
                                                .ToList();
                                            <div class="js-product-item d-flex gap-2 align-items-end">
                                                <div class="flex-grow-1">
                                                    <select data-field-product="ProdutosCodigos" name="@($"{prefix}.ProdutosCodigos[{j}]")" asp-items="prodOptions" class="form-select form-select-sm">
                                                        <option value="">Selecione o produto</option>
                                                    </select>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-outline-danger js-remove-product">Remover</button>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="button" class="btn btn-danger" data-wizard-next>Próximo</button>
                </div>
            </section>

            @* ============================== ETAPA 2 — IDENTIFICAÇÃO ============================== *@
            <section class="wizard-step d-none" data-wizard-step="1">
                <div class="mb-3">
                    <h2 class="h4 mb-1">Identificação</h2>
                    <p class="text-body-secondary mb-0">Informe seus dados para registrar o agendamento. Se já possui cadastro, basta informar o mesmo telefone.</p>
                </div>

                <div class="row g-3">
                    <div class="col-lg-6">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Seu nome completo" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="col-lg-6">
                        <label asp-for="Telefone" class="form-label"></label>
                        <input asp-for="Telefone" class="form-control" placeholder="Ex: 17999998888" maxlength="11" />
                        <span asp-validation-for="Telefone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="alert alert-light border-danger-subtle mt-3">
                    <strong>Já é cliente?</strong> Se você já possui cadastro, basta informar o mesmo telefone. O sistema irá reconhecê-lo automaticamente.
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-danger" data-wizard-prev>Anterior</button>
                    <button type="button" class="btn btn-danger" data-wizard-next>Próximo</button>
                </div>
            </section>

            @* ============================== ETAPA 3 — REVISÃO ============================== *@
            <section class="wizard-step d-none" data-wizard-step="2">
                <div class="row g-3">
                    <div class="col-lg-7">
                        <div class="card border-danger-subtle h-100">
                            <div class="card-header bg-danger-subtle border-danger-subtle">
                                <h2 class="h5 mb-0">Resumo do agendamento</h2>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Cliente</span>
                                        <strong id="summary-client-name">-</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Telefone</span>
                                        <strong id="summary-client-phone">-</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Data</span>
                                        <strong id="summary-date">-</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Serviços</span>
                                        <strong id="summary-svc-count">0</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="text-body-secondary">Produtos</span>
                                        <strong id="summary-prod-count">0</strong>
                                    </li>
                                </ul>

                                <div class="mt-3" id="summary-services-detail"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card border-danger-subtle bg-danger-subtle h-100">
                            <div class="card-body d-flex flex-column gap-3">
                                <div>
                                    <h2 class="h5 mb-2">Conferência final</h2>
                                    <p class="mb-0 text-body-secondary">Reveja as informações antes de confirmar. Se algo estiver errado, volte para a etapa correspondente.</p>
                                </div>
                                <div class="alert alert-light border-danger-subtle mb-0">
                                    Ao confirmar, o agendamento será registrado como <strong>Pendente</strong> e a equipe será notificada.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-danger" data-wizard-prev>Anterior</button>
                    <button type="submit" class="btn btn-danger btn-lg">Confirmar agendamento</button>
                </div>
            </section>
        </form>
    </div>
</div>

@* ============================== TEMPLATE — SERVIÇO ============================== *@
<template id="svc-client-template">
    <div class="js-svc-client-row card border-danger-subtle">
        <div class="card-header bg-danger-subtle border-danger-subtle d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-danger-emphasis js-svc-title">Serviço #</span>
            <button type="button" class="btn btn-sm btn-outline-danger js-remove-svc">Remover</button>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-6">
                    <label class="form-label">Serviço</label>
                    <select data-field="ServicoId" asp-items="Model.ServicosList" class="form-select">
                        <option value="">Selecione o serviço</option>
                    </select>
                </div>
                <div class="col-lg-6">
                    <label class="form-label">Profissional</label>
                    <select data-field="FuncionarioId" asp-items="Model.FuncionariosList" class="form-select js-func-select">
                        <option value="">Selecione o profissional</option>
                    </select>
                </div>
                <div class="col-lg-4">
                    <label class="form-label">Horário disponível</label>
                    <select data-field="Horario" class="form-select js-horario-select">
                        <option value="">Selecione profissional e data</option>
                    </select>
                </div>
                <div class="col-lg-8">
                    <label class="form-label">Observação</label>
                    <input data-field="Obs" type="text" class="form-control" placeholder="Alguma observação? (opcional)" />
                </div>
            </div>

            <hr class="my-3 border-danger-subtle" />

            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold text-body-secondary">Produtos (opcional)</span>
                <button type="button" class="btn btn-sm btn-outline-secondary js-add-product-btn">Adicionar produto</button>
            </div>
            <div class="js-product-list vstack gap-2"></div>
        </div>
    </div>
</template>

@* ============================== TEMPLATE — PRODUTO ============================== *@
<template id="product-client-template">
    <div class="js-product-item d-flex gap-2 align-items-end">
        <div class="flex-grow-1">
            <select data-field-product="ProdutosCodigos" asp-items="Model.ProdutosList" class="form-select form-select-sm">
                <option value="">Selecione o produto</option>
            </select>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger js-remove-product">Remover</button>
    </div>
</template>

<script>
(function () {
    // ==========================================
    // HELPERS
    // ==========================================
    var svcContainer = document.getElementById('service-client-rows');
    var addSvcBtn = document.getElementById('add-service-client');
    var svcTemplate = document.getElementById('svc-client-template');
    var prodTemplate = document.getElementById('product-client-template');
    var dateInput = document.getElementById('client-data');
    var nomeInput = document.getElementById('Nome');
    var telefoneInput = document.getElementById('Telefone');

    var steps = Array.from(document.querySelectorAll('[data-wizard-step]'));
    var stepButtons = Array.from(document.querySelectorAll('[data-step-button]'));
    var stepIndicator = document.getElementById('wizard-step-indicator');
    var currentStep = 0;

    // ==========================================
    // WIZARD NAVIGATION
    // ==========================================
    function setStep(step) {
        currentStep = Math.max(0, Math.min(step, steps.length - 1));
        steps.forEach(function (pane, idx) {
            pane.classList.toggle('d-none', idx !== currentStep);
        });
        stepButtons.forEach(function (btn) {
            var s = Number(btn.dataset.stepButton);
            btn.classList.toggle('btn-danger', s === currentStep);
            btn.classList.toggle('btn-outline-danger', s !== currentStep);
        });
        if (stepIndicator) {
            stepIndicator.textContent = 'Etapa ' + (currentStep + 1) + ' de ' + steps.length;
        }
        if (currentStep === steps.length - 1) updateSummary();
    }

    document.querySelectorAll('[data-wizard-next]').forEach(function (btn) {
        btn.addEventListener('click', function () { setStep(currentStep + 1); });
    });
    document.querySelectorAll('[data-wizard-prev]').forEach(function (btn) {
        btn.addEventListener('click', function () { setStep(currentStep - 1); });
    });
    stepButtons.forEach(function (btn) {
        btn.addEventListener('click', function () { setStep(Number(btn.dataset.stepButton)); });
    });

    // ==========================================
    // RENUMBER ALL FIELDS
    // ==========================================
    function renumberAll() {
        var rows = svcContainer.querySelectorAll('.js-svc-client-row');
        rows.forEach(function (row, svcIdx) {
            // Title
            var title = row.querySelector('.js-svc-title');
            if (title) title.textContent = 'Serviço #' + (svcIdx + 1);

            // Service-level fields
            row.querySelectorAll('[data-field]').forEach(function (el) {
                el.name = 'Servicos[' + svcIdx + '].' + el.dataset.field;
            });

            // Product fields within this service
            var productItems = row.querySelectorAll('.js-product-item');
            productItems.forEach(function (prodItem, prodIdx) {
                var sel = prodItem.querySelector('[data-field-product]');
                if (sel) {
                    sel.name = 'Servicos[' + svcIdx + '].ProdutosCodigos[' + prodIdx + ']';
                }
            });
        });
    }

    // ==========================================
    // ADD / REMOVE SERVICE
    // ==========================================
    if (addSvcBtn && svcTemplate) {
        addSvcBtn.addEventListener('click', function () {
            var clone = svcTemplate.content.cloneNode(true);
            svcContainer.appendChild(clone);
            renumberAll();
            hookHorarioListeners();
        });
    }

    svcContainer.addEventListener('click', function (e) {
        if (!(e.target instanceof HTMLElement)) return;
        if (e.target.classList.contains('js-remove-svc')) {
            var rows = svcContainer.querySelectorAll('.js-svc-client-row');
            if (rows.length <= 1) return;
            var row = e.target.closest('.js-svc-client-row');
            if (row) { row.remove(); renumberAll(); }
        }
    });

    // ==========================================
    // ADD / REMOVE PRODUCT (inside service)
    // ==========================================
    svcContainer.addEventListener('click', function (e) {
        if (!(e.target instanceof HTMLElement)) return;

        if (e.target.classList.contains('js-add-product-btn')) {
            var svcRow = e.target.closest('.js-svc-client-row');
            var prodList = svcRow.querySelector('.js-product-list');
            if (prodTemplate && prodList) {
                prodList.appendChild(prodTemplate.content.cloneNode(true));
                renumberAll();
            }
        }

        if (e.target.classList.contains('js-remove-product')) {
            var prodItem = e.target.closest('.js-product-item');
            if (prodItem) { prodItem.remove(); renumberAll(); }
        }
    });

    // ==========================================
    // HORÁRIOS DISPONÍVEIS (AJAX)
    // ==========================================
    function loadHorarios(svcRow) {
        var funcSelect = svcRow.querySelector('.js-func-select');
        var horarioSelect = svcRow.querySelector('.js-horario-select');
        var funcionarioId = funcSelect ? funcSelect.value : '';
        var data = dateInput ? dateInput.value : '';

        if (!funcionarioId || !data) {
            if (horarioSelect) {
                horarioSelect.innerHTML = '<option value="">Selecione profissional e data</option>';
            }
            return;
        }

        horarioSelect.innerHTML = '<option value="">Carregando...</option>';

        fetch('/Agendamentos/ObterHorariosDisponiveis?funcionarioId=' + encodeURIComponent(funcionarioId) + '&data=' + encodeURIComponent(data))
            .then(function (r) { return r.json(); })
            .then(function (horarios) {
                horarioSelect.innerHTML = '<option value="">Selecione o horário</option>';
                if (horarios.length === 0) {
                    horarioSelect.innerHTML = '<option value="">Nenhum horário disponível</option>';
                    return;
                }
                horarios.forEach(function (h) {
                    var opt = document.createElement('option');
                    opt.value = h.valor;
                    opt.textContent = h.texto;
                    horarioSelect.appendChild(opt);
                });
            })
            .catch(function () {
                horarioSelect.innerHTML = '<option value="">Erro ao carregar</option>';
            });
    }

    function hookHorarioListeners() {
        svcContainer.querySelectorAll('.js-func-select').forEach(function (sel) {
            if (sel.dataset.hooked) return;
            sel.dataset.hooked = 'true';
            sel.addEventListener('change', function () {
                loadHorarios(sel.closest('.js-svc-client-row'));
            });
        });
    }

    if (dateInput) {
        dateInput.addEventListener('change', function () {
            svcContainer.querySelectorAll('.js-svc-client-row').forEach(function (row) {
                loadHorarios(row);
            });
        });
    }

    // ==========================================
    // SUMMARY
    // ==========================================
    function selectedText(sel) {
        if (!sel || sel.selectedIndex < 0) return '-';
        var opt = sel.options[sel.selectedIndex];
        return opt && opt.value ? opt.textContent.trim() : '-';
    }

    function updateSummary() {
        var summaryName = document.getElementById('summary-client-name');
        var summaryPhone = document.getElementById('summary-client-phone');
        var summaryDate = document.getElementById('summary-date');
        var summaryServiceCount = document.getElementById('summary-svc-count');
        var summaryProductCount = document.getElementById('summary-prod-count');
        var summaryDetail = document.getElementById('summary-services-detail');

        if (summaryName) summaryName.textContent = nomeInput ? nomeInput.value || '-' : '-';
        if (summaryPhone) summaryPhone.textContent = telefoneInput ? telefoneInput.value || '-' : '-';

        if (summaryDate && dateInput && dateInput.value) {
            var parts = dateInput.value.split('-');
            summaryDate.textContent = parts[2] + '/' + parts[1] + '/' + parts[0];
        }

        var svcRows = svcContainer.querySelectorAll('.js-svc-client-row');
        if (summaryServiceCount) summaryServiceCount.textContent = svcRows.length;

        var totalProducts = 0;
        var detailHtml = '';
        svcRows.forEach(function (row, idx) {
            var svcSel = row.querySelector('[data-field="ServicoId"]');
            var funcSel = row.querySelector('[data-field="FuncionarioId"]');
            var horSel = row.querySelector('[data-field="Horario"]');
            var prodCount = row.querySelectorAll('.js-product-item').length;
            totalProducts += prodCount;

            detailHtml += '<div class="border rounded p-2 mb-2 bg-body-tertiary">';
            detailHtml += '<strong>' + selectedText(svcSel) + '</strong>';
            detailHtml += ' — ' + selectedText(funcSel);
            detailHtml += ' às <span class="badge text-bg-danger">' + (horSel ? (horSel.value || '?') : '?') + '</span>';
            if (prodCount > 0) {
                detailHtml += ' <span class="badge text-bg-secondary ms-1">' + prodCount + ' produto(s)</span>';
            }
            detailHtml += '</div>';
        });
        if (summaryProductCount) summaryProductCount.textContent = totalProducts;
        if (summaryDetail) summaryDetail.innerHTML = detailHtml;
    }

    // ==========================================
    // INIT
    // ==========================================
    document.addEventListener('DOMContentLoaded', function () {
        renumberAll();
        hookHorarioListeners();
        setStep(0);
    });
})();
</script>
