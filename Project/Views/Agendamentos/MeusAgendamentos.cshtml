@* 
   Modelo que define que a View recebe uma coleção de objetos AgendamentoListagemViewModel.
   Usado para mostrar os agendamentos específicos de um cliente logado.
*@
@model IEnumerable<FabysUnha.ViewModels.AgendamentoListagemViewModel>

@{
    ViewData["Title"] = "Meus Agendamentos";
}

<div class="container mt-4">
    <!-- Cabeçalho contendo o nome do cliente logado e o botão de sair -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Meus Agendamentos</h2>
            <p class="text-muted">
                @* Recupera e exibe o nome do cliente que foi armazenado previamente na Sessão *@
                Bem-vindo, <strong>@ViewContext.HttpContext.Session.GetString("ClienteNome")</strong>!
            </p>
        </div>
        <div class="col-md-4 text-end">
            <!-- Botão de Logout que invoca a Action Logout na Controller Agendamentos -->
            <a href="@Url.Action("Logout", "Agendamentos")" class="btn btn-outline-danger">
                Sair
            </a>
        </div>
    </div>

    @* Verifica se existem agendamentos para este cliente *@
    @if (Model.Any())
    {
        <div class="row">
            @* Percorre cada agendamento e gera um "card" (cartão) para exibição dos dados *@
            @foreach (var agendamento in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card h-100 shadow-sm">
                        <!-- Cabeçalho do cartão indicando o número e status do agendamento -->
                        <div class="card-header bg-danger-subtle text-danger-emphasis">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h6 class="mb-0">Agendamento #@agendamento.Nr</h6>
                                </div>
                                <div class="col-auto">
                                    <!-- Badge exibindo o status atual do agendamento -->
                                    <span class="badge bg-success">@agendamento.Status</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Corpo do cartão exibindo a data, hora e o valor total -->
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">Data</small>
                                    <p class="mb-0"><strong>@agendamento.DataHora.ToString("dd/MM/yyyy HH:mm")</strong></p>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">Total</small>
                                    @* Formatação de valores numéricos como string no formato de duas casas decimais ("F2") *@
                                    <p class="mb-0"><strong>R$ @agendamento.Total.ToString("F2")</strong></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Caso não existam agendamentos, um alerta encorajando a criar um novo é exibido -->
        <div class="alert alert-info" role="alert">
            <h5 class="alert-heading">Nenhum agendamento</h5>
            <p>Você ainda não possui agendamentos cadastrados.</p>
            <hr>
            <a href="@Url.Action("Agendar", "Agendamentos")" class="btn btn-danger">
                Fazer um Agendamento
            </a>
        </div>
    }
</div>
