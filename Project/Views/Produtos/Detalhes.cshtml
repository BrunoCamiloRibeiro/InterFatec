@model ProdutoDetalhesViewModel

@{
    ViewData["Title"] = "Detalhes do produto";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card border-danger-subtle shadow-sm">
            <div class="card-header bg-danger-subtle border-danger-subtle d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <h1 class="h3 mb-1 text-danger-emphasis">Detalhes do produto</h1>
                    <p class="mb-0 text-body-secondary">Visualize cadastro, preço e a imagem associada ao item.</p>
                </div>

                <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">#@Model.Codigo</span>
            </div>

            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-body-secondary">Nome</dt>
                            <dd class="col-sm-8">@Model.Nome</dd>

                            <dt class="col-sm-4 text-body-secondary">Marca</dt>
                            <dd class="col-sm-8">@Model.NomeMarca</dd>

                            <dt class="col-sm-4 text-body-secondary">Preço</dt>
                            <dd class="col-sm-8">@Model.PrecoFormatado</dd>

                            <dt class="col-sm-4 text-body-secondary">Status</dt>
                            <dd class="col-sm-8 mb-0">@Model.Status</dd>
                        </dl>
                    </div>

                    <div class="col-lg-5">
                        <div class="card border-danger-subtle bg-body-tertiary h-100">
                            <div class="card-body">
                                <h2 class="h5 mb-3">Imagem</h2>
                                @if (!string.IsNullOrWhiteSpace(Model.PathImagem))
                                {
                                    <img src="@Model.PathImagem" alt="@Model.Nome" class="img-fluid rounded-4 shadow-sm w-100" />
                                    <p class="mt-3 mb-0 text-body-secondary small">@Model.PathImagem</p>
                                }
                                else
                                {
                                    <p class="mb-0 text-body-secondary">Sem imagem cadastrada.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-danger" asp-action="Editar" asp-route-id="@Model.Codigo">Editar</a>
                    <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
                </div>
            </div>
        </div>
    </div>
</div>