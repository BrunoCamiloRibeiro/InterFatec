@model ProdutoEditarViewModel

@{
    ViewData["Title"] = "Editar produto";
}

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card border-danger-subtle shadow-sm">
            <div class="card-header bg-danger-subtle border-danger-subtle">
                <h1 class="h3 mb-0 text-danger-emphasis">Editar produto</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="Editar" method="post" class="vstack gap-3" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Codigo" />
                    <div asp-validation-summary="All" class="alert alert-danger mb-0" role="alert"></div>

                    <div>
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="MarcaId" class="form-label"></label>
                            <select asp-for="MarcaId" asp-items="Model.MarcasList" class="form-select">
                                <option value="">Selecione</option>
                            </select>
                            <span asp-validation-for="MarcaId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProdutoStatus>()" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Preco" class="form-label"></label>
                            <input asp-for="Preco" class="form-control" />
                            <span asp-validation-for="Preco" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImagemUpload" class="form-label"></label>
                            <input asp-for="ImagemUpload" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="ImagemUpload" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PathImagem" class="form-label"></label>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(Model.PathImagem))
                                {
                                    <img src="@Model.PathImagem" alt="Imagem" width="40" height="40" class="rounded object-fit-cover" />
                                }
                                <input asp-for="PathImagem" class="form-control" placeholder="Ou insira o link da imagem..." />
                            </div>
                            <span asp-validation-for="PathImagem" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
                        <button type="submit" class="btn btn-danger">Salvar alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>