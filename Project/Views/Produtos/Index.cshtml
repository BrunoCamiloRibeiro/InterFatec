@model IEnumerable<ProdutoListagemViewModel>

@{
	ViewData["Title"] = "Produtos";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
	<div>
		<p class="text-uppercase small fw-semibold text-danger-emphasis mb-1">Cadastro</p>
		<h1 class="display-6 fw-bold mb-1">Produtos</h1>
		<p class="text-body-secondary mb-0">Gerencie o catálogo, preços e marca de cada item.</p>
	</div>

	<a class="btn btn-danger btn-lg" asp-action="Criar">Novo produto</a>
</div>

@if (Model?.Any() == true)
{
	<div class="card border-danger-subtle shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-danger">
					<tr>
						<th>Código</th>
						<th>Nome</th>
						<th>Marca</th>
						<th>Preço</th>
						<th>Status</th>
						<th class="text-end">Ações</th>
					</tr>
				</thead>
				<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>@item.Codigo</td>
						<td class="fw-semibold">@item.Nome</td>
						<td>@item.NomeMarca</td>
						<td>@item.PrecoFormatado</td>
						<td>@item.Status</td>
						<td>
							<div class="d-flex flex-wrap justify-content-end gap-2">
								<a class="btn btn-sm btn-outline-secondary" asp-action="Detalhes" asp-route-id="@item.Codigo">Detalhes</a>
								<a class="btn btn-sm btn-outline-danger" asp-action="Editar" asp-route-id="@item.Codigo">Editar</a>
								<a class="btn btn-sm btn-danger" asp-action="Excluir" asp-route-id="@item.Codigo">Excluir</a>
							</div>
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
else
{
	<div class="alert alert-light border border-danger-subtle mb-0">
		Nenhum produto cadastrado.
	</div>
}
